# ─────────────────────────────────────────────
# FXMind Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=FXMind
APP_ENV=development
DEBUG=true
DEMO_MODE=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string-in-production

# ── Database ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fxmind
POSTGRES_USER=fxmind
POSTGRES_PASSWORD=fxmind_dev_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── API Server ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=FXMind

# ── JWT Authentication ───────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Market Data ──────────────────────────────
# Provider: demo | csv | oanda
MARKET_DATA_PROVIDER=demo
# For CSV provider
CSV_DATA_DIR=./data/raw
# For OANDA (future)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice

# ── ML Configuration ────────────────────────
MODEL_ARTIFACTS_DIR=./ml/artifacts
TRAINING_CONFIG=./configs/training.yaml

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─────────────────────────────────────────────
# FXMind Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=FXMind
APP_ENV=development
DEBUG=true
DEMO_MODE=true
BROKER_FEATURES_ENABLED=false
LOG_LEVEL=INFO

# ── MongoDB ───────────────────────────────────
# Paste the connection string from MongoDB Atlas and URL-encode special
# characters in the username/password. Keep this secret out of source control.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=fxmind

# ── API Server ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=FXMind
NEXT_PUBLIC_BROKER_FEATURES_ENABLED=false

# ── JWT Authentication ───────────────────────
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Market Data ──────────────────────────────
# Provider: demo | csv | oanda
MARKET_DATA_PROVIDER=demo
# For CSV provider
CSV_DATA_DIR=./data/raw
# For OANDA (future)
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENVIRONMENT=practice

# ── ML Configuration ────────────────────────
MODEL_ARTIFACTS_DIR=./ml/artifacts
TRAINING_CONFIG=./configs/training.yaml

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_PER_MINUTE=60
